# URL de conexao com o PostgreSQL, no formato
# postgresql+psycopg2://usuario:senha@host:porta/banco
# Nenhum valor de conexao fica em arquivo versionado, nem de desenvolvimento.
DATABASE_URL=

# Segundos de espera na verificacao de saude do banco.
HEALTH_DB_TIMEOUT_SECONDS=

# Nivel de log da aplicacao: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=

# Defina como 1 para que os testes que exigem PostgreSQL falhem quando o banco
# nao responder, em vez de serem pulados. Use na verificacao final da entrega.
EXIGIR_POSTGRES=

# Numero de iteracoes da derivacao de senha (PBKDF2-HMAC-SHA256). Sem valor, a
# aplicacao usa 600000, a recomendacao vigente do OWASP. Parametro de custo:
# quanto maior, mais caro e adivinhar uma senha — e mais lenta e cada
# autenticacao. Diminua apenas em ambiente de teste.
SENHA_ITERACOES=

# Senha do gestor criado pelo comando de bootstrap, usada uma unica vez na
# instalacao. Nao ha senha padrao: sem esta variavel, o comando pede a senha no
# terminal e falha se nao houver como pedir.
BOOTSTRAP_SENHA_INICIAL=
